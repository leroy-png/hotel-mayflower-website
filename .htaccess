# Hotel Mayflower static site
# Neutralize rewrite rules inherited from the parent folder (main-site WordPress
# rules otherwise send missing files to a non-existent index.php -> 500)
RewriteEngine On

# Canonical host for the live domain: always https://www.hotelmayflower.nl
# (matches the canonical/hreflang tags in every page). Scoped by hostname so
# the test subdomain keeps working untouched.
# Never redirect the ACME path: Let's Encrypt validates over plain http
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTP_HOST} ^(www\.)?hotelmayflower\.nl$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.hotelmayflower.nl%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTP_HOST} ^hotelmayflower\.nl$ [NC]
RewriteRule ^ https://www.hotelmayflower.nl%{REQUEST_URI} [R=301,L]

# Short QR-friendly URLs for the guest guide (language picked from the browser)
RewriteCond %{HTTP:Accept-Language} ^nl [NC]
RewriteRule ^(gids|guide)/?$ /nl/gids/ [R=302,L]
RewriteRule ^(gids|guide)/?$ /en/guide/ [R=302,L]

# --- Redirects from the old WordPress site (301, keeps search rankings) ---
# Specific rules first: mod_alias uses the first match.
RedirectMatch 301 ^/rooms/single-room/?$ /en/rooms/single/
RedirectMatch 301 ^/rooms/double-room/?$ /en/rooms/double/
RedirectMatch 301 ^/rooms/triple-room/?$ /en/rooms/triple/
RedirectMatch 301 ^/rooms/apartments/?$ /en/rooms/
RedirectMatch 301 ^/rooms/?$ /en/rooms/
RedirectMatch 301 ^/a[c]{1,2}o?[c]?ommodations/?$ /en/rooms/
RedirectMatch 301 ^/location/?$ /en/leiden/
RedirectMatch 301 ^/activities/?$ /en/leiden/
RedirectMatch 301 ^/restaurants/?$ /en/leiden/
RedirectMatch 301 ^/contact/?$ /en/contact/
# Theme demo pages for facilities this hotel does not have: send to the homepage
RedirectMatch 301 ^/(spa|news|sample-page)/?$ /en/
RedirectMatch 301 ^/portfolio_category/rooms/?$ /en/rooms/
RedirectMatch 301 ^/portfolio_category/.*$ /en/
RedirectMatch 301 ^/portfolio-items/.*$ /en/

# --- Caching: pages must revalidate; version-stamped assets may cache long ---
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Never serve version-control, deploy or config files
RedirectMatch 404 (?i)/\.(git|cpanel)
RedirectMatch 404 (?i)mail-config.*\.php$
RedirectMatch 404 (?i)/\.data(/|$)
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
